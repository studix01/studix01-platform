<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Search | Studix01.net</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <div class="navbar container">
      <a href="/" class="logo">📚 Studix01</a>
      <ul class="nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/subjects">Subjects</a></li>
        <li><a href="/lessons">Lessons</a></li>
      </ul>
      <button id="theme-toggle" class="theme-toggle">🌙</button>
    </div>
  </header>

  <main class="container">
    <section class="hero">
      <h1>🔎 Search Results</h1>
      <p>Search query: <%= query || 'all materials' %></p>
    </section>

    <section class="section">
      <% if (results.length > 0) { %>
        <div class="lessons-grid">
          <% results.forEach(result => { %>
            <div class="card lesson-card">
              <div class="content">
                <h3><%= result.title %></h3>
                <p class="text-muted"><%= result.subject %> • <%= result.class %></p>
              </div>
              <div class="lesson-actions">
                <a href="/lesson/<%= result.id %>" class="btn btn-primary btn-small">Open</a>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="card text-center">
          <h3>No results found</h3>
          <p>Please try another keyword.</p>
        </div>
      <% } %>
    </section>
  </main>

  <footer>
    <div class="footer-bottom container">
      <p>© 2024 Studix01.net</p>
    </div>
  </footer>
  <script src="/js/script.js"></script>
</body>
</html>






















