<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Exercises | Studix01.net</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <div class="navbar container">
      <a href="/" class="logo">📚 Studix01</a>
      <ul class="nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/subjects">Subjects</a></li>
        <li><a href="/lessons">Lessons</a></li>
        <li><a href="/exercises">Exercises</a></li>
        <li><a href="/quizzes">Quizzes</a></li>
      </ul>
      <button id="theme-toggle" class="theme-toggle">🌙</button>
    </div>
  </header>

  <main class="container">
    <section class="hero">
      <h1>✏️ Exercises</h1>
      <p>Practice with exercises to reinforce what you learn.</p>
    </section>

    <section class="section">
      <div class="lessons-grid">
        <% subjects.forEach(subject => { %>
          <div class="card lesson-card">
            <div class="content">
              <span class="badge badge-primary"><%= subject.name %></span>
              <h3>Practice Set</h3>
              <p class="text-muted">Questions for structured learning and revision.</p>
            </div>
            <div class="lesson-actions">
              <button class="btn btn-primary btn-small">Start</button>
            </div>
          </div>
        <% }); %>
      </div>
    </section>
  </main>

  <footer>
    <div class="footer-bottom container">
      <p>© 2024 Studix01.net</p>
    </div>
  </footer>
  <script src="/js/script.js"></script>
</body>
</html>























































