<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lessons | Studix01.net</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <div class="navbar container">
      <a href="/" class="logo">📚 Studix01</a>
      <ul class="nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/subjects">Subjects</a></li>
        <li><a href="/lessons">Lessons</a></li>
        <li><a href="/books">Books</a></li>
        <li><a href="/exercises">Exercises</a></li>
      </ul>
      <button id="theme-toggle" class="theme-toggle">🌙</button>
    </div>
  </header>

  <main class="container">
    <section class="hero">
      <h1>📘 Lessons</h1>
      <p>Explore lessons for Senior 1, Senior 2, and Senior 3.</p>
      <div class="cta-row">
        <a href="/lessons?class=S1" class="btn btn-primary">Senior 1</a>
        <a href="/lessons?class=S2" class="btn btn-secondary">Senior 2</a>
        <a href="/lessons?class=S3" class="btn btn-primary">Senior 3</a>
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">Lessons for <%= filter %></h2>
      <div class="lessons-grid">
        <% lessons.forEach(lesson => { %>
          <div class="card lesson-card">
            <div class="content">
              <span class="badge badge-primary"><%= lesson.class %></span>
              <h3><%= lesson.title %></h3>
              <div class="lesson-meta">
                <span>📘 <%= lesson.subject %></span>
                <span>📊 <%= lesson.level %></span>
              </div>
            </div>
            <div class="lesson-actions">
              <a href="/lesson/<%= lesson.id %>" class="btn btn-primary btn-small">Read</a>
              <button class="btn-icon" onclick="saveLessom(<%= lesson.id %>)">📌</button>
            </div>
          </div>
        <% }); %>
      </div>
    </section>
  </main>

  <footer>
    <div class="footer-bottom container">
      <p>© 2024 Studix01.net</p>
    </div>
  </footer>
  <script src="/js/script.js"></script>
</body>
</html>









































