<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Exam Revision | Studix01.net</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <div class="navbar container">
      <a href="/" class="logo">📚 Studix01</a>
      <ul class="nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/subjects">Subjects</a></li>
        <li><a href="/lessons">Lessons</a></li>
        <li><a href="/revision">Revision</a></li>
      </ul>
      <button id="theme-toggle" class="theme-toggle">🌙</button>
    </div>
  </header>

  <main class="container">
    <section class="hero">
      <h1>📝 Exam Revision</h1>
      <p>Prepare confidently for exams with summary notes, practice questions, and revision guides.</p>
    </section>

    <section class="section">
      <div class="lessons-grid">
        <% subjects.forEach(subject => { %>
          <div class="card lesson-card">
            <div class="content">
              <span class="badge badge-success"><%= subject.name %></span>
              <h3>Revision Pack</h3>
              <p class="text-muted">Quick recap, key formulas and likely exam questions.</p>
            </div>
            <div class="lesson-actions">
              <button class="btn btn-primary btn-small">Open</button>
            </div>
          </div>
        <% }); %>
      </div>
    </section>
  </main>

  <footer>
    <div class="footer-bottom container">
      <p>© 2024 Studix01.net</p>
    </div>
  </footer>
  <script src="/js/script.js"></script>
</body>
</html>
















