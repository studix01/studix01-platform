<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Books & Notes | Studix01.net</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <div class="navbar container">
      <a href="/" class="logo">📚 Studix01</a>
      <ul class="nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/subjects">Subjects</a></li>
        <li><a href="/lessons">Lessons</a></li>
        <li><a href="/books">Books & Notes</a></li>
        <li><a href="/quizzes">Quizzes</a></li>
      </ul>
      <button id="theme-toggle" class="theme-toggle">🌙</button>
    </div>
  </header>

  <main class="container">
    <section class="hero">
      <h1>📖 Books & Notes</h1>
      <p>Read useful study notes and download learning materials.</p>
    </section>

    <section class="section">
      <div class="lessons-grid">
        <div class="card lesson-card">
          <h3>Mathematics Notes</h3>
          <p class="text-muted">Senior 1 to S3 revision notes</p>
          <div class="lesson-actions">
            <button class="btn btn-primary btn-small">Download</button>
            <button class="btn-icon">📥</button>
          </div>
        </div>
        <div class="card lesson-card">
          <h3>Physics Revision Pack</h3>
          <p class="text-muted">Concepts, formulas and example questions</p>
          <div class="lesson-actions">
            <button class="btn btn-primary btn-small">Download</button>
            <button class="btn-icon">📥</button>
          </div>
        </div>
        <div class="card lesson-card">
          <h3>Biology Summary Notes</h3>
          <p class="text-muted">Short, structured and exam-friendly</p>
          <div class="lesson-actions">
            <button class="btn btn-primary btn-small">Download</button>
            <button class="btn-icon">📥</button>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="footer-bottom container">
      <p>© 2024 Studix01.net</p>
    </div>
  </footer>
  <script src="/js/script.js"></script>
</body>
</html>
















