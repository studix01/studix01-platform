<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI Study Assistant | Studix01.net</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <div class="navbar container">
      <a href="/" class="logo">📚 Studix01</a>
      <ul class="nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/subjects">Subjects</a></li>
        <li><a href="/lessons">Lessons</a></li>
        <li><a href="/ai-assistant">AI Assistant</a></li>
      </ul>
      <button id="theme-toggle" class="theme-toggle">🌙</button>
    </div>
  </header>

  <main class="container">
    <section class="hero">
      <h1>🤖 AI Study Assistant</h1>
      <p>Ask about tough lessons and get clear explanations.</p>
    </section>

    <section class="section">
      <div class="chat-container">
        <div class="chat-messages" id="chat-messages">
          <div class="message ai">Hello! Ask me any question about a lesson, formula, or exam topic.</div>
        </div>
        <div class="chat-input">
          <input id="chat-input" type="text" placeholder="Type your question here...">
          <button type="button" onclick="sendMessage()">Send</button>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="footer-bottom container">
      <p>© 2024 Studix01.net</p>
    </div>
  </footer>
  <script src="/js/script.js"></script>
</body>
</html>















