<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quizzes | Studix01.net</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <div class="navbar container">
      <a href="/" class="logo">📚 Studix01</a>
      <ul class="nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/subjects">Subjects</a></li>
        <li><a href="/lessons">Lessons</a></li>
        <li><a href="/quizzes">Quizzes</a></li>
        <li><a href="/revision">Revision</a></li>
      </ul>
      <button id="theme-toggle" class="theme-toggle">🌙</button>
    </div>
  </header>

  <main class="container">
    <section class="hero">
      <h1>🧪 Quizzes</h1>
      <p>Take quizzes and track your progress from classwork to exam prep.</p>
    </section>

    <section class="section">
      <% quizzes.forEach(quiz => { %>
        <div class="card quiz-card">
          <div>
            <h3><%= quiz.title %></h3>
            <p><%= quiz.subject %> • <%= quiz.questions %> questions</p>
          </div>
          <div class="quiz-stats">
            <span>⏱️ <%= quiz.timeLimit %> min</span>
            <a href="/quiz/<%= quiz.id %>" class="btn btn-primary">Start</a>
          </div>
        </div>
      <% }); %>
    </section>
  </main>

  <footer>
    <div class="footer-bottom container">
      <p>© 2024 Studix01.net</p>
    </div>
  </footer>
  <script src="/js/script.js"></script>
</body>
</html>

















