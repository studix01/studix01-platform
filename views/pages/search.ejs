<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Dashboard | Studix01.net</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <div class="navbar container">
      <a href="/" class="logo">📚 Studix01</a>
      <ul class="nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/subjects">Subjects</a></li>
        <li><a href="/dashboard">Dashboard</a></li>
      </ul>
      <button id="theme-toggle" class="theme-toggle">🌙</button>
    </div>
  </header>

  <main class="container">
    <section class="hero">
      <h1>📊 Student Dashboard</h1>
      <p>Track your learning progress and study goals.</p>
    </section>

    <section class="section">
      <div class="dashboard-grid">
        <div class="stat-card">
          <div class="stat-value">12</div>
          <div class="stat-label">Lessons Completed</div>
        </div>
        <div class="stat-card">
          <div class="stat-value">85%</div>
          <div class="stat-label">Average Score</div>
        </div>
        <div class="stat-card">
          <div class="stat-value">5</div>
          <div class="stat-label">Quizzes Taken</div>
        </div>
        <div class="stat-card">
          <div class="stat-value">3</div>
          <div class="stat-label">Saved Lessons</div>
        </div>
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">Recent Lessons</h2>
      <div class="lessons-grid">
        <% lessons.slice(0, 4).forEach(lesson => { %>
          <div class="card lesson-card">
            <div class="content">
              <h3><%= lesson.title %></h3>
              <div class="lesson-meta">
                <span>📘 <%= lesson.subject %></span>
                <span>📊 <%= lesson.class %></span>
              </div>
            </div>
            <div class="lesson-actions">
              <a href="/lesson/<%= lesson.id %>" class="btn btn-primary btn-small">Open</a>
            </div>
          </div>
        <% }); %>
      </div>
    </section>
  </main>

  <footer>
    <div class="footer-bottom container">
      <p>© 2024 Studix01.net</p>
    </div>
  </footer>
  <script src="/js/script.js"></script>
</body>
</html>

































